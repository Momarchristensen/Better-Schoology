# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.python-version

# ── Virtual environments ──────────────────────────────
.venv/
venv/
env/
ENV/

# ── Secrets / local config ────────────────────────────
# config.example.json is the tracked template
config.json
.env
.env.*
!.env.example

# ── Runtime data (written next to server.py when run from source) ──
cached_files/
*.log
libreoffice/
libreoffice.tmp/
libreoffice.zip
libreoffice.zip.part

# ── Whisper model (downloaded in CI / at runtime) ─────
whisper-base/

# ── PyInstaller / build output ────────────────────────
build/
dist/
*.spec
/update.exe
*.exe.old

# ── Node tooling ──────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# ── Editors ───────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# ── OS files ──────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Scratch / test scripts ────────────────────────────
/test*.py